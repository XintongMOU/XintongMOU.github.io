@unpublished{mou2025governance,
  abbr={Working Paper},
  title={Board Composition, Executive Networks, and ESG Disclosure: Evidence from Staggered Adoption Designs},
  author={MOU, Xintong},
  year={2025},
  note={Working paper, City University of Hong Kong},
  abstract={This paper examines the causal effect of board composition on corporate ESG disclosure using a panel dataset of over one million corporate records. To address endogeneity in staggered adoption designs, I implement the Callaway & Sant'Anna (2021) CSDID estimator, which corrects for negative-weighting biases inherent in traditional Two-Way Fixed Effects models. Social Network Analysis is integrated to decouple transmission mechanisms from firm-level heterogeneity. Robustness is assessed via Oster's (2019) Delta and 500-round placebo tests.},
  selected={true}
}

@unpublished{mou2025carbon,
  abbr={Working Paper},
  title={Carbon Price Forecasting in the EU ETS: An ARMAX-GDEA Approach with Machine Learning Benchmarks},
  author={MOU, Xintong},
  year={2025},
  note={Working paper, City University of Hong Kong},
  abstract={This paper proposes an ARMAX-GDEA framework for forecasting carbon allowance prices in the EU Emissions Trading System (ETS). Three empirical experiments compare the model against standard ML benchmarks, evaluating predictive accuracy and interpretability across different market regimes.},
